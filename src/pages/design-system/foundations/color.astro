---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import ColorFoundation from '@esa/docs/ColorFoundation.astro';

// The semantic roles + their live values come from @esa/docs and read from the
// active theme at runtime. This spoke's own primitive ramps (generated from the
// recipe in src/styles/theme-due-diligence.json) are passed via `ramps`.
const ramp = (prefix: string) =>
  Array.from({ length: 12 }, (_, i) => ({ step: String(i + 1), token: `${prefix}-${i + 1}` }));
---
<DocsLayout title="Color: Due Diligence" activeHref="/design-system/foundations/color">
  <ColorFoundation
    brand="Due Diligence"
    ramps={[
      { name: 'Cobalt (brand)', steps: ramp('dd-brand') },
      { name: 'Slate (neutrals)', steps: ramp('dd-neutral') },
    ]}
  />
</DocsLayout>
