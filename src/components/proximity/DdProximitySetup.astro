---
// DdProximitySetup: the Search Distances card, the ring map on the left and the
// distances panel on the right, in one white card.
//
// bcn-lego-checked: esa-card pads its body and stacks header/body/footer; this
// card is a two-column split with a full-bleed map, so it is a plain card
// surface (white, 1px border-subtle, 8px corners) around the two sections.
import DdProximityMap from './DdProximityMap.astro';
import DdProximityPanel from './DdProximityPanel.astro';
const target = `${import.meta.env.BASE_URL}app/cottonwood/site-boundary/`;
---
<script is:inline define:vars={{ target }}>
  // No boundary, no rings: send the user to define the area first, before the
  // old site draws. Reads the same sessionStorage key as dd-store.
  try {
    const s = JSON.parse(sessionStorage.getItem('dd-proto-state') || '{}');
    if (s.boundary && s.boundary !== 'defined') location.replace(target);
  } catch (e) { /* no storage: stay */ }
</script>
<section class="prox-setup" aria-label="Search Distances">
  <DdProximityMap />
  <DdProximityPanel />
</section>

<style>
  /* Full width, as Geospatial: the card spans the main column (window minus
     the side nav and the 40px page gutters), centred on the 1160px well. */
  .prox-setup {
    --prox-side: 264px;
    --prox-w: calc(100vw - var(--prox-side) - 80px);
    width: var(--prox-w);
    margin-inline: calc((100% - var(--prox-w)) / 2);
    min-height: max(640px, calc(100vh - 230px));
    display: grid;
    grid-template-columns: minmax(0, 1fr) 418px;
    border: 1px solid var(--dd-border-subtle);
    border-radius: 8px;
    background: var(--dd-surface-raised);
    overflow: hidden;
  }
  :global(html[data-dd-sidebar-collapsed]) .prox-setup { --prox-side: 0px; }
  .prox-setup > :global(.prox-panel) { box-shadow: inset 1px 0 0 var(--dd-border-subtle); /* neutral pane divider */ }
</style>
