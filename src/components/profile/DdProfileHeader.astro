---
// DdProfileHeader: the Site Profile H1 row (run line, Change Distances, Run
// Again) and the toolbar (Proximity / Themes / Layers filter popovers, Print,
// Export menu). The actions and toolbar hide while a run is in progress.
import DdPageTitle from '../shell/DdPageTitle.astro';
import DdIcon from '../common/DdIcon.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { run, rings, themes, progressLayers, mi } from './profile-model';
import { withBase } from '../../lib/base';

const ringOptions = rings.map((r) => ({
  index: r.ringIndex,
  label: r.ringIndex === 0 ? 'On Site' : mi(r.toMiles),
}));
const proximityValue = ringOptions.map((r) => r.label).join(', ');
---
<div class="dd-profile-header">
  <DdPageTitle project="Cottonwood" title="Site Profile">
    <div slot="actions" class="dd-profile-header__actions" data-profile-chrome>
      <span class="dd-profile-header__run dd-t-13">
        <DdIcon name="clock" size="xs" />
        <span data-profile-run-label>{run.runLabel}</span>
      </span>
      <EsaButton variant="ghost" size="sm" href={withBase('/app/cottonwood/proximity/')}>
        <DdIcon name="diameter" size="xs" />
        Change Distances
      </EsaButton>
      <EsaButton variant="secondary" size="sm" data-profile-run-again>
        <DdIcon name="refresh-cw" size="xs" />
        Run Again
      </EsaButton>
    </div>

    <div slot="below" class="dd-profile-header__toolbar" data-profile-chrome>
      <div class="dd-profile-header__filters">
        <esa-popover trigger="click" position="bottom" has-arrow="false" label="Proximity" class="dd-profile-header__pop dd-profile-header__pop--start">
          <EsaButton variant="secondary" size="sm" iconRight="chevron-down">
            <DdIcon name="diameter" size="xs" />
            <span class="dd-profile-header__key">Proximity</span>
            <span class="dd-profile-header__val" data-filter-value="rings">{proximityValue}</span>
          </EsaButton>
          <div slot="content" class="dd-profile-header__list" data-filter-list="rings">
            {ringOptions.map((r) => <esa-checkbox size="sm" label={r.label} checked data-value={r.index}></esa-checkbox>)}
          </div>
        </esa-popover>

        <esa-popover trigger="click" position="bottom" has-arrow="false" label="Themes" class="dd-profile-header__pop dd-profile-header__pop--start">
          <EsaButton variant="secondary" size="sm" iconRight="chevron-down">
            <DdIcon name="sliders-horizontal" size="xs" />
            <span class="dd-profile-header__key">Themes</span>
            <span class="dd-profile-header__val" data-filter-value="themes">All {themes.length}</span>
          </EsaButton>
          <div slot="content" class="dd-profile-header__list" data-filter-list="themes">
            {themes.map((t) => <esa-checkbox size="sm" label={t.name} checked data-value={t.id}></esa-checkbox>)}
          </div>
        </esa-popover>

        <esa-popover trigger="click" position="bottom" has-arrow="false" label="Layers" class="dd-profile-header__pop dd-profile-header__pop--start">
          <EsaButton variant="secondary" size="sm" iconRight="chevron-down">
            <DdIcon name="layers" size="xs" />
            <span class="dd-profile-header__key">Layers</span>
            <span class="dd-profile-header__val" data-filter-value="layers">{progressLayers.length}</span>
          </EsaButton>
          <div slot="content" class="dd-profile-header__list dd-profile-header__list--scroll" data-filter-list="layers">
            {progressLayers.map((l) => <esa-checkbox size="sm" label={l.name} checked data-value={l.id}></esa-checkbox>)}
          </div>
        </esa-popover>
      </div>

      <div class="dd-profile-header__tools">
        <EsaButton variant="ghost" size="sm" data-profile-print>
          <DdIcon name="printer" size="xs" />
          Print
        </EsaButton>
        <esa-dropdown-menu position="below-end" data-profile-export>
          <EsaButton variant="ghost" size="sm" iconRight="chevron-down">
            <DdIcon name="download" size="xs" />
            Export
          </EsaButton>
        </esa-dropdown-menu>
      </div>
    </div>
  </DdPageTitle>
</div>

<script>
  import '@esa/ecology/esa-popover';
  import '@esa/ecology/esa-checkbox';
  import '@esa/ecology/esa-dropdown-menu';
  import { startRun, runLabel, onState, getState } from '../../lib/dd-store';
  import { setFilters } from './profile-filters';
  import { onRingView, ringView, effFinding } from './profile-rings';
  import { progressLayers, rings, themes, mi } from './profile-model';

  const root = document.querySelector<HTMLElement>('.dd-profile-header');
  if (root) {
    const label = root.querySelector<HTMLElement>('[data-profile-run-label]');
    const paintLabel = (): void => {
      if (label && getState().runStartedAt !== null) label.textContent = runLabel();
    };
    paintLabel();
    onState(paintLabel);

    root.querySelector('[data-profile-run-again]')?.addEventListener('click', () => {
      startRun();
      window.scrollTo({ top: 0 });
    });
    root.querySelector('[data-profile-print]')?.addEventListener('click', () => window.print());

    // Export menu
    const menu = root.querySelector('[data-profile-export]') as (HTMLElement & { items: unknown[] }) | null;
    if (menu) {
      menu.items = [
        { label: 'PDF', action: 'pdf' },
        { label: 'Print', action: 'print' },
        { label: 'Table CSV', action: 'csv' },
      ];
      menu.addEventListener('menu-action', (e) => {
        const action = (e as CustomEvent<string>).detail;
        if (action === 'csv') downloadCsv();
        else window.print();
      });
    }

    // Filter lists
    const checked = (list: string): number[] =>
      Array.from(root.querySelectorAll<HTMLElement & { checked: boolean }>(`[data-filter-list="${list}"] esa-checkbox`))
        .filter((c) => c.checked)
        .map((c) => Number(c.dataset.value));

    const setValue = (list: string, text: string): void => {
      const el = root.querySelector<HTMLElement>(`[data-filter-value="${list}"]`);
      if (el) el.textContent = text;
    };

    root.querySelectorAll<HTMLElement>('[data-filter-list]').forEach((list) => {
      // esa-popover toggles on any click inside its anchor, panel included; keep it open while ticking boxes.
      list.addEventListener('click', (e) => e.stopPropagation());
      list.addEventListener('change', () => {
        const kind = list.dataset.filterList!;
        const ids = checked(kind);
        if (kind === 'themes') {
          setValue('themes', ids.length === themes.length ? `All ${themes.length}` : `${ids.length} of ${themes.length}`);
          setFilters({ themes: ids.length === themes.length ? null : ids });
        } else if (kind === 'layers') {
          setValue('layers', ids.length === progressLayers.length ? String(progressLayers.length) : `${ids.length} of ${progressLayers.length}`);
          setFilters({ layers: ids.length === progressLayers.length ? null : ids });
        } else {
          paintRings();
        }
      });
    });

    // Proximity lists only the rings the run measured.
    const paintRings = (): void => {
      const v = ringView();
      const ids = checked('rings');
      const labels = rings
        .filter((r) => v.isShown(r.ringIndex) && ids.includes(r.ringIndex))
        .map((r) => (r.ringIndex === 0 ? 'On Site' : mi(r.toMiles)));
      setValue('rings', labels.length ? labels.join(', ') : 'None');
    };
    onRingView((v) => {
      root.querySelectorAll<HTMLElement>('[data-filter-list="rings"] esa-checkbox').forEach((c) => {
        c.hidden = !v.isShown(Number(c.dataset.value));
      });
      paintRings();
    });
  }

  function downloadCsv(): void {
    const v = ringView();
    const cols = rings.filter((r) => v.isShown(r.ringIndex));
    const head = ['Theme', 'Layer', 'Source', 'Finding', ...cols.map((r) => r.displayLabel)];
    const esc = (s: string): string => `"${s.replace(/"/g, '""')}"`;
    const rows = progressLayers.map((l) => [
      l.theme, l.name, l.sourceAgency, effFinding(l, v),
      ...cols.map((r) => l.result.byRing?.[r.ringIndex]?.cell ?? ''),
    ]);
    const csv = [head, ...rows].map((r) => r.map(esc).join(',')).join('\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
    a.download = 'cottonwood-site-profile.csv';
    a.click();
    URL.revokeObjectURL(a.href);
  }
</script>

<style>
  .dd-profile-header [hidden] { display: none !important; }
  .dd-profile-header__actions { display: flex; align-items: center; gap: 12px; }
  .dd-profile-header__run { display: inline-flex; align-items: center; gap: 6px; color: var(--dd-text-muted); margin-right: 4px; }

  .dd-profile-header__toolbar {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding-bottom: 16px; border-bottom: 1px solid var(--dd-border-subtle);
  }
  .dd-profile-header__filters, .dd-profile-header__tools { display: flex; align-items: center; gap: 8px; }

  /* Neutral outline button (the Figma's secondary): esa-button's secondary is a brand-muted fill
     in this theme, so its documented private accent hooks are re-pointed at the neutrals. */
  .dd-profile-header :global(.esa-button--variant-secondary) {
    --_accent: var(--dd-surface-raised);
    --_accent-hover: var(--dd-surface-hover);
    --_on: var(--dd-text);
    --_accent-border: var(--dd-border);
  }
  .dd-profile-header :global(.esa-button__label) { display: inline-flex; align-items: center; gap: 6px; }
  .dd-profile-header__actions :global(.esa-button__native) { font-size: 14px; font-weight: 500; }
  .dd-profile-header__toolbar :global(.esa-button__native) { font-size: 13px; }
  .dd-profile-header__key { color: var(--dd-text-muted); font-weight: 400; }
  .dd-profile-header__val { color: var(--dd-text); font-weight: 500; }

  /* Popover anchored at the trigger's left edge, as in the Figma. */
  .dd-profile-header__pop { --popover-max-width: 320px; }
  .dd-profile-header__list {
    display: flex; flex-direction: column; gap: 8px; min-width: 200px; padding: 4px 2px;
  }
  .dd-profile-header__list--scroll { max-height: 360px; overflow-y: auto; }

  @media print { .dd-profile-header__toolbar, .dd-profile-header__actions { display: none; } }
</style>
