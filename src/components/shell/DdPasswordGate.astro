---
// DdPasswordGate: a client-side password lock in front of every page, after
// CB Fish's cbf-password-gate (esassoc/cb-fish-design, src/components/shared/
// cbf-password-gate.astro + gate-password.ts).
//
// A CASUAL DETERRENT, not access control: this site builds to static HTML, so
// the check runs in the visitor's browser, the password ships in the page, and
// the content is in the HTML under the lock. It keeps the prototype from being
// stumbled on; it does not protect it from a determined viewer.
//
// Differs from CB Fish in one way: CB Fish wraps one page's content in a slot.
// Here the gate has to cover every page, including the design-system pages that
// render inside @esa/docs DocsShell, whose chrome sits outside any slot we own.
// So the gate is a fixed full-viewport layer, and an inline head script marks
// <html data-dd-locked> before first paint so nothing behind it flashes.
// Unlock state persists per tab in sessionStorage, as in CB Fish.
//
// bcn-lego-checked: no esa- lego models a full-page pre-content lock screen;
// esa-dialog is a modal over visible chrome and esa-loading-overlay is a
// transient spinner (same finding as cbf-password-gate). Every control inside is
// a lego: esa-card, esa-text-field (its errorText carries the wrong-password
// message), esa-button. dd-password-gate is the reusable home.
import EsaCard from '@esa/ecology/esa-card.astro';
import EsaButton from '@esa/ecology/esa-button.astro';
import { GATE_PASSWORD, GATE_STORAGE_KEY } from './gate-password';
---
<div class="dd-gate" data-dd-gate role="dialog" aria-modal="true" aria-labelledby="dd-gate-title">
  <div class="dd-gate__panel">
    <EsaCard variant="outlined" padding="spacious">
      <form class="dd-gate__body stack" data-gap="lg" data-dd-gate-form>
        <div class="dd-gate__head">
          <img class="dd-gate__mark" src={`${import.meta.env.BASE_URL}brand/dd-mark.svg`} width="28" height="28" alt="" />
          <h1 id="dd-gate-title" class="dd-t-display-22">Due Diligence</h1>
        </div>
        <esa-text-field type="password" label="Password" data-dd-gate-input required></esa-text-field>
        <EsaButton type="submit" variant="primary">Unlock</EsaButton>
      </form>
    </EsaCard>
  </div>
  <script type="application/json" data-dd-gate-password set:html={JSON.stringify(GATE_PASSWORD)}></script>
</div>

<script is:inline define:vars={{ key: GATE_STORAGE_KEY }}>
  try {
    if (sessionStorage.getItem(key) !== '1') document.documentElement.setAttribute('data-dd-locked', '');
  } catch (e) {
    document.documentElement.setAttribute('data-dd-locked', '');
  }
</script>

<style is:global>
  .dd-gate { display: none; }
  html[data-dd-locked] { overflow: hidden; }
  html[data-dd-locked] body * { visibility: hidden; }
  html[data-dd-locked] .dd-gate,
  html[data-dd-locked] .dd-gate * { visibility: visible; }
  html[data-dd-locked] .dd-gate {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: var(--dd-bg, #f6f7f7);
  }
  .dd-gate__panel { width: 100%; max-width: 24rem; }
  .dd-gate__head { display: flex; align-items: center; gap: 10px; }
  .dd-gate__head h1 { margin: 0; color: var(--dd-text); }
  .dd-gate__mark { flex: none; }
  .dd-gate__body esa-button,
  .dd-gate__body .esa-button { width: 100%; justify-content: center; }
</style>

<script>
  import '@esa/ecology/esa-text-field';
  import { GATE_STORAGE_KEY } from './gate-password';

  type GateTextField = HTMLElement & { value: string; errorText: string };

  const root = document.querySelector<HTMLElement>('[data-dd-gate]');
  const form = root?.querySelector<HTMLFormElement>('[data-dd-gate-form]');
  const input = root?.querySelector<GateTextField>('[data-dd-gate-input]');
  const pw = root?.querySelector<HTMLScriptElement>('[data-dd-gate-password]');

  if (root && form && input && pw) {
    const expected: string = JSON.parse(pw.textContent ?? '""');
    const unlock = (): void => {
      try { sessionStorage.setItem(GATE_STORAGE_KEY, '1'); } catch { /* private mode: unlock this view only */ }
      document.documentElement.removeAttribute('data-dd-locked');
    };
    const check = (): void => {
      if (input.value === expected) {
        unlock();
      } else {
        input.errorText = 'Incorrect password. Try again.';
        input.value = '';
      }
    };
    form.addEventListener('submit', (e) => { e.preventDefault(); check(); });
    // The password field lives in a shadow root, so Enter does not submit the
    // light-DOM form on its own.
    input.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') { e.preventDefault(); check(); }
    });
    if (document.documentElement.hasAttribute('data-dd-locked')) {
      requestAnimationFrame(() => (input as HTMLElement).focus());
    }
  }
</script>
